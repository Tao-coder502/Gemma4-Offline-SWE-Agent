{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SWEAgentTaskManifest",
  "description": "Deterministic schema for held-out SWE evaluation task manifests.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "task_id",
      "repository",
      "commit",
      "issue_reference",
      "category",
      "difficulty",
      "files_expected",
      "development_or_heldout",
      "task_hash",
      "repository_hash"
    ],
    "properties": {
      "task_id": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_.-]+__[a-zA-Z0-9_.-]+$"
      },
      "repository": {
        "type": "string"
      },
      "commit": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{40}$"
      },
      "issue_reference": {
        "type": "string"
      },
      "category": {
        "type": "string",
        "enum": [
          "self-contained/local",
          "caller-callee dependency",
          "dynamic dispatch",
          "inheritance",
          "registration/factory",
          "cross-module dependency",
          "test/fixture indirection",
          "multi-file behavioral change"
        ]
      },
      "difficulty": {
        "type": "string",
        "enum": ["easy", "medium", "hard"]
      },
      "files_expected": {
        "type": "array",
        "items": {"type": "string"}
      },
      "development_or_heldout": {
        "type": "string",
        "enum": ["development", "heldout"]
      },
      "task_hash": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{64}$"
      },
      "repository_hash": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{64}$"
      }
    }
  }
}
